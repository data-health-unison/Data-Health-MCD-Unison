# SAKBE_TOKENS es una variable de entorno que contiene los tokens de acceso a la API de SAKBE.
# Si tienes varios tokens, sepáralos con comas. Por ejemplo:
# SAKBE_TOKENS=token1,token2,token3
# Obten los tokens en la pagina de SAKBE
SAKBE_TOKENS=

# CARTO_API_KEY es la llave de CARTO para el mapa base de los mapas del tablero y del notebook.
# Sin ella los mapas usan OpenStreetMap. Se obtiene en https://carto.com/basemaps/apikey
CARTO_API_KEY=
